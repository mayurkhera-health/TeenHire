# The app talks to plain Postgres with PostGIS. Nothing here is specific to a
# hosting provider, so where the database lives stays a deploy-time decision.
#
# Local (see README for the one-time cluster setup):
DATABASE_URL=postgres://postgres@127.0.0.1:5433/teenhire?sslmode=disable
#
# Managed Postgres (Cloud SQL, Neon, Supabase, Fly MPG) — TLS is on unless the
# URL says otherwise:
# DATABASE_URL=postgres://user:password@host:5432/teenhire

# Signs session tokens and peppers one-time codes. Required in production —
# the app refuses to start without it there.
AUTH_SECRET=change-me-in-production

# Development only. Logs the six-digit code so a local session can sign in
# without a mail provider configured. Ignored when NODE_ENV=production.
AUTH_DEV_CODES=1

# Comma-separated addresses that become admins when they sign in. There is no
# other way to get the role, and no self-service path to it.
ADMIN_CONTACTS=ops@example.com

# ── Notifications ──────────────────────────────────────────────────────────

# Which sender the delivery seam uses.
#
#   resend  send email through Resend (production)
#   log     write messages to the console (development only)
#   none    compose and record messages but deliver nothing, deliberately
#
# There is no default in production. The app refuses to start with "log"
# there, because a logging sender fails silently forever: students stop
# hearing about opportunities and every screen still looks fine. Running
# without notifications is a legitimate choice — it just has to be typed out.
NOTIFY_PROVIDER=log

# Resend. Required when NOTIFY_PROVIDER=resend, and the app names whichever
# one is missing rather than saying it is misconfigured.
# RESEND_API_KEY=re_...
#
# Before you own a domain: Resend's own shared address needs no DNS at all and
# will only deliver to the address on your Resend account. That restriction is
# the point — you cannot reach a real student by accident before the domain is
# ready. It is not a launch configuration.
# NOTIFY_FROM=TeenHire <onboarding@resend.dev>
#
# The sending address. Its domain has to be verified in Resend — SPF, DKIM
# and a DMARC record — or every send is refused. Use a subdomain such as
# mail.teenhire.com so that a deliverability problem with notifications
# cannot damage the reputation of the domain you send real mail from.
# NOTIFY_FROM=TeenHire <notifications@mail.teenhire.com>
#
# Optional. Where a student's reply goes, which for mail to teenagers should
# be somewhere a person actually reads.
# NOTIFY_REPLY_TO=hello@teenhire.com

# Lets whatever runs on a schedule ask the app to drain its queue. Without it
# POST /api/notify/drain refuses every request, so nothing is ever sent —
# closed rather than open, because an unauthenticated drain endpoint lets
# anyone who finds the URL decide when a teenager's phone buzzes.
# Any long random string: `openssl rand -base64 32`.
NOTIFY_WORKER_SECRET=change-me

# The origin links in messages point at. A message with a relative link is a
# message nobody can open from their inbox — and the unsubscribe link in every
# email is built from this, so a wrong value makes unsubscribing impossible.
APP_URL=http://localhost:3000
