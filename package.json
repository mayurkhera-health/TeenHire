{
  "name": "teenhire",
  "version": "0.1.0",
  "private": true,
  "description": "A local opportunity marketplace for high-school students.",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "db:migrate": "for f in db/migrations/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done",
    "db:seed": "tsx db/seed.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "tsx tests/parity.manual.ts && tsx tests/server.manual.ts && tsx tests/delivery.manual.ts",
    "notify:work": "tsx scripts/notify-worker.ts",
    "test:journey": "node tests/journey.mjs"
  },
  "dependencies": {
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "playwright": "^1.56.1",
    "tsx": "^4.23.13",
    "typescript": "5.7.2"
  }
}
